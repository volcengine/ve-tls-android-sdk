<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <application android:label="TLS Producer Demo" 
               android:allowBackup="false"
               android:networkSecurityConfig="@xml/network_security_config">
    <activity android:name="com.volcengine.tls.android.demo.ConfigActivity" android:exported="false"/>
    <activity android:name="com.volcengine.tls.android.demo.FormalBenchmarkActivity" android:exported="false"/>
    <activity android:name="com.volcengine.tls.android.demo.MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <activity android:name="com.volcengine.tls.android.demo.BenchmarkActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <service
        android:name="com.volcengine.tls.android.demo.FormalBenchmarkService"
        android:exported="false"
        android:foregroundServiceType="dataSync"/>
  </application>
</manifest>
